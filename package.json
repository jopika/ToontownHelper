{
  "name": "toontownhelper",
  "productName": "ToontownHelper",
  "version": "1.9.0",
  "description": "Toontown Helper for tasks syncing across groups",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.cjs",
    "check:import-casing": "node scripts/check-import-casing.cjs",
    "make": "env-cmd electron-forge make",
    "publish": "env-cmd electron-forge publish",
    "action-publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "42.0.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "styled-components": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "keywords": [],
  "author": "Jopika",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "update-electron-app": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jopika/ToontownHelper.git"
  }
}
